rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null
        && 'email' in request.auth.token
        && request.auth.token.email.lower() == 'abdullahsazid109@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // Public pricing config (readable by everyone for Landing Page & Settings, writable only by Owner)
    match /app_config/{docId} {
      allow read: if true;
      allow write: if isOwner();
    }

    // Public sanitized shared exam results (single doc read by unguessable id, writable by authenticated tutors)
    match /shared_results/{resultId} {
      allow get: if true;
      allow create: if request.auth != null && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isOwner() || (request.auth != null && resource.data.ownerUid == request.auth.uid);
    }

    // Public sanitized shared parent portals (single doc read by unguessable id, writable by authenticated tutors)
    match /shared_portals/{portalId} {
      allow get: if true;
      allow create: if request.auth != null && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isOwner() || (request.auth != null && resource.data.ownerUid == request.auth.uid);
    }

    // bKash / Nagad / Rocket TrxID Pro upgrade requests
    match /upgrade_requests/{docId} {
      allow create, update: if request.auth != null
        && request.auth.uid == docId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending';
      allow read: if request.auth != null
        && (request.auth.uid == docId || (resource != null && request.auth.uid == resource.data.uid));
      allow read, write: if isOwner();
    }

    // Phase 1 Multi-Tenant Tutor Path (/tutors/{tutorId} and all subcollections)
    match /tutors/{tutorId}/data/billing {
      allow read: if (request.auth != null && request.auth.uid == tutorId) || isOwner();
      allow write: if isOwner() || (
        request.auth != null
        && request.auth.uid == tutorId
        && (!('plan' in request.resource.data) || request.resource.data.plan == 'free' || (resource != null && request.resource.data.plan == resource.data.plan))
      );
    }

    match /tutors/{tutorId}/{document=**} {
      allow read: if (request.auth != null && request.auth.uid == tutorId) || isOwner();
      allow write: if isOwner() || (
        request.auth != null
        && request.auth.uid == tutorId
        && request.path != /databases/$(database)/documents/tutors/$(tutorId)/data/billing
      );
    }

    // Legacy User Path (/users/{userId} for backward compatibility)
    match /users/{userId}/data/billing {
      allow read: if (request.auth != null && request.auth.uid == userId) || isOwner();
      allow write: if isOwner() || (
        request.auth != null
        && request.auth.uid == userId
        && (!('plan' in request.resource.data) || request.resource.data.plan == 'free' || (resource != null && request.resource.data.plan == resource.data.plan))
      );
    }

    match /users/{userId}/{document=**} {
      allow read: if (request.auth != null && request.auth.uid == userId) || isOwner();
      allow write: if isOwner() || (
        request.auth != null
        && request.auth.uid == userId
        && request.path != /databases/$(database)/documents/users/$(userId)/data/billing
      );
    }

    // Owner Admin full access fallback
    match /{document=**} {
      allow read, write: if isOwner();
    }
  }
}
